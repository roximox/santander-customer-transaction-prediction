# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments and secrets
.venv/
venv/
.env
.env.*
secrets/
*.secret

# Jupyter and editors
.ipynb_checkpoints/
.idea/
.vscode/

# Operating systems and logs
.DS_Store
Thumbs.db
*.log

# Temporary outputs
outputs/
tmp/
temp/
*.tmp

# Data (retain directory placeholders)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized models (retain directory placeholder)
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pickle
*.onnx

# Generated reports (retain directory placeholders/templates)
reports/figures/*
!reports/figures/.gitkeep
reports/tables/*
!reports/tables/.gitkeep
reports/experiments/*
!reports/experiments/.gitkeep
!reports/experiments/experiment_template.csv
